{
  "name": "adriamics",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.22"
  },
  "scripts": {
    "build": "bun build.ts && bun study/build-study.ts",
    "build:website": "bun build.ts --preserve-study",
    "build:study": "bun study/build-study.ts",
    "dev": "bun dev.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "esbuild": "^0.28.1",
    "katex": "^0.19.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  },
  "packageManager": "bun@1.2.22"
}
