{
  "name": "adriamics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx build.ts && tsx study/build-study.ts",
    "build:website": "tsx build.ts --preserve-study",
    "build:study": "tsx study/build-study.ts",
    "dev": "tsx dev.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
