{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "adriamics",
    "compatibility_date": "2026-08-24",
    "workers_dev": false,
    "routes": [
        { "pattern": "adriamics.com", "custom_domain": true },
        { "pattern": "www.adriamics.com", "custom_domain": true }
    ],
    "assets": {
        "directory": "./public"
    }
}
